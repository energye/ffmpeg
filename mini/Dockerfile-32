FROM ffbuild-mini:latest
ENV DEBIAN_FRONTEND=noninteractive
# 32位目标链（同源archive，直接多架构装）。
# 先upgrade对齐：底包早些时候装的amd64库，源又滚动过，不对齐就版本互斥。
RUN dpkg --add-architecture i386 \
 && apt-get update && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends \
      gcc-multilib libc6-dev-i386 \
    && rm -rf /var/lib/apt/lists/*
# 安全库静态编一份（386，-m32）：同x64的理由，不动态欠账。
COPY mini/openssl-3.0.16.tar.gz /tmp/openssl.tgz
RUN tar -xzf /tmp/openssl.tgz -C /tmp \
 && cd /tmp/openssl-3.0.16 \
 && ./Configure linux-x86 -m32 -fPIC no-shared --prefix=/opt/ossl-386 \
 && make -j"$(nproc)" && make install_sw \
 && rm -rf /tmp/openssl-3.0.16 /tmp/openssl.tgz
# zlib静态编一份（386，同安全库的理由，不欠动态账）。
COPY mini/zlib-1.3.1.tar.gz /tmp/zlib.tgz
RUN tar -xzf /tmp/zlib.tgz -C /tmp \
 && cd /tmp/zlib-1.3.1 \
 && CC="gcc -m32" CFLAGS="-m32 -fPIC" ./configure --static --prefix=/opt/zlib-386 \
 && make -j"$(nproc)" && make install \
 && rm -rf /tmp/zlib-1.3.1 /tmp/zlib.tgz
